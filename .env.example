# ============================================================================
# TELEGRAM
# ============================================================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=agent_session
TELEGRAM_BOT_TOKEN=your_bot_token

# ============================================================================
# LLM (Local or API)
# ============================================================================
LLM_MODEL=qwen-2.5-72b
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=http://localhost:11434/v1

# ============================================================================
# DATABASE CREDENTIALS (Client DBs - stored encrypted in production)
# ============================================================================
DB_CREDENTIALS={
    "client1": {
        "type": "postgresql",
        "host": "db.client1.com",
        "port": 5432,
        "user": "agent_user",
        "password": "agent_password",
        "database": "client_db"
    },
    "client2": {
        "type": "mongodb",
        "uri": "mongodb://agent_user:agent_password@db.client2.com:27017"
    }
}

# ============================================================================
# PRODUCTION SERVERS
# ============================================================================
PROD_SERVERS={
    "client1_vps": {
        "type": "ssh",
        "host": "vps.client1.com",
        "port": 22,
        "user": "deploy",
        "password": "deploy_password"
    },
    "cloudflare_workers": {
        "type": "cloudflare"
    },
    "docker_hub": {
        "type": "docker",
        "repo": "your_dockerhub_username/agent-deploy"
    }
}

# ============================================================================
# CLOUDFLARE
# ============================================================================
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# ============================================================================
# PAYMENT
# ============================================================================
USDC_CONTRACT=0x...  # Claw Earn contract address

# ============================================================================
# SECURITY (Minimal - as requested)
# ============================================================================
SANDBOX_ENABLED=false
MAX_EXECUTION_TIME=300
ALLOWED_EGRESS=["*"]
